{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Australian Intelligence Response Pack",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "categories"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "default": "en-AU"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "patterns",
          "responses"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "responses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "safetyLevel": {
            "enum": [
              "comedy",
              "caution",
              "serious"
            ]
          }
        }
      }
    }
  }
}
